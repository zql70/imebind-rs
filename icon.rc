#pragma code_page(65001)
// exe 资源定义：图标 + 版本信息。
//
// 图标资源 ID 用 1：Windows 用"编号最小的图标组"作为 exe 在资源管理器里显示的图标，
// 写成 IDI_ICON1（32512）这种大编号反而不一定会被选中。
1 ICON "icon.ico"

// 版本信息：没有这段的话，exe 属性里的"文件版本/产品名称/说明"都是空的。
// 版本号要和 Cargo.toml 里的 version 保持一致。
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "zql70"
            // 任务管理器进程列表的名称就取这个字段，保持精简
            VALUE "FileDescription",  "ImeBind"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "imebind"
            VALUE "LegalCopyright",   "Copyright (C) 2026 zql70"
            VALUE "OriginalFilename", "imebind.exe"
            VALUE "ProductName",      "ImeBind"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
